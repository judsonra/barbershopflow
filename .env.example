POSTGRES_DB=barbershop
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://barbershop:change-me@db:5432/barbershop?sslmode=disable
API_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Login social (staff com e-mail e clientes). Vazio = login social desabilitado
# (endpoint responde 501). Criar em console.cloud.google.com/apis/credentials
# e developers.facebook.com/apps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Envio de senha por SMS/WhatsApp para clientes sem e-mail (Zenvia). Vazio =
# a senha só é registrada no log da API (uso em dev), nada é enviado de fato.
ZENVIA_API_TOKEN=
ZENVIA_FROM_SMS=BarberFlow
ZENVIA_FROM_WHATSAPP=BarberFlow
